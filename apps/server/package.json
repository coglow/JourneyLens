{
  "name": "@journeylens/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.tools.json",
    "db:generate": "prisma generate",
    "prebuild": "pnpm --filter @journeylens/shared run build && prisma generate",
    "pretest": "pnpm --filter @journeylens/shared run build && prisma generate",
    "pretypecheck": "pnpm --filter @journeylens/shared run build && prisma generate",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.1",
    "@journeylens/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
